# Infisical Universal Auth machine identity (read-only, scoped to one project/env/path).
# Copy to .env.agent, fill in, then: chmod 600 .env.agent
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=<client id>
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=<client secret>

# Deployment-specific values, substituted into the agent config and template at start.
# Allowed characters: letters, digits and . _ : / -
INFISICAL_ADDRESS=https://<your-infisical-host>
INFISICAL_PROJECT_ID=<project id>
INFISICAL_ENV=<env slug>
